/* =========================================
RESET
========================================= */

*,
*::before,
*::after {
box-sizing: border-box;
margin: 0;
padding: 0;
}

html {
scroll-behavior: smooth;
scroll-padding-top: 80px;
}

body {
font-family: "DM Sans", sans-serif;
background: #f4f0e8;
color: #111111;
line-height: 1.6;
overflow-x: hidden;
}

img {
max-width: 100%;
display: block;
}

a {
color: inherit;
text-decoration: none;
}

button {
font: inherit;
}

ul {
list-style: none;
}


/* =========================================
VARIABLES
========================================= */

:root {

--background: #f4f0e8;
--surface: #ffffff;
--dark: #111111;
--muted: #77736c;

--accent: #d7ff3f;
--accent-dark: #b8df22;

--border: rgba(17, 17, 17, 0.15);

--container: 1200px;

--space-xs: 0.5rem;
--space-sm: 1rem;
--space-md: 2rem;
--space-lg: 4rem;
--space-xl: 7rem;

}


/* =========================================
GLOBAL
========================================= */

.container {
width: min(
calc(100% - 3rem),
var(--container)
);

margin-inline: auto;
}

.section {
padding: var(--space-xl) 0;
}

.section-light {
background: var(--background);
}

.section-dark {
background: var(--dark);
color: #ffffff;
}

.section-accent {
background: var(--accent);
color: var(--dark);
}

.eyebrow {
font-family: "Space Grotesk", sans-serif;
font-size: 0.75rem;
font-weight: 600;
letter-spacing: 0.16em;
text-transform: uppercase;
margin-bottom: 1rem;
}

.section-heading {
display: grid;
grid-template-columns: 100px 1fr;
gap: 2rem;
margin-bottom: 5rem;
}

.section-heading h2 {
max-width: 800px;
font-family: "Space Grotesk", sans-serif;
font-size: clamp(2.5rem, 6vw, 5rem);
line-height: 0.98;
letter-spacing: -0.05em;
}

.section-index {
font-family: "Space Grotesk", sans-serif;
font-size: 0.9rem;
font-weight: 600;
}

.section-heading-dark .section-index {
color: var(--accent);
}

.section-heading-dark .eyebrow {
color: #999999;
}


/* =========================================
NAVBAR
========================================= */

.site-header {
position: fixed;
z-index: 1000;
top: 0;
left: 0;
width: 100%;

background: rgba(244, 240, 232, 0.88);

backdrop-filter: blur(16px);
-webkit-backdrop-filter: blur(16px);

border-bottom: 1px solid rgba(17, 17, 17, 0.08);
}

.navbar {
min-height: 76px;

display: flex;
align-items: center;
justify-content: space-between;
}

.logo {
font-family: "Space Grotesk", sans-serif;
font-size: 1.35rem;
font-weight: 700;
letter-spacing: -0.05em;
}

.logo span {
color: #6f8a00;
}

.nav-menu {
display: flex;
align-items: center;
gap: 1.5rem;
}

.nav-menu a {
position: relative;

font-size: 0.8rem;
font-weight: 600;

transition: opacity 0.2s ease;
}

.nav-menu a:hover {
opacity: 0.55;
}

.menu-toggle {
display: none;

width: 42px;
height: 42px;

border: 0;
background: transparent;

cursor: pointer;
}

.menu-toggle span {
display: block;

width: 24px;
height: 2px;

background: #111111;

margin: 6px auto;

transition: 0.3s ease;
}


/* =========================================
HERO
========================================= */

.hero {
min-height: 100vh;
padding-top: 140px;

display: flex;
align-items: center;

background:
radial-gradient(
circle at 80% 20%,
rgba(215, 255, 63, 0.5),
transparent 30%
),
var(--background);
}

.hero-grid {
display: grid;
grid-template-columns: 1.2fr 0.8fr;
align-items: center;
gap: 5rem;
}

.hero-content {
max-width: 780px;
}

.hero h1 {
font-family: "Space Grotesk", sans-serif;

font-size: clamp(
3.5rem,
8vw,
8rem
);

line-height: 0.88;
letter-spacing: -0.07em;

margin-bottom: 2rem;
}

.hero h1 span {
display: block;
color: #77736c;
}

.hero-description {
max-width: 620px;

color: #5e5a54;

font-size: 1.1rem;
line-height: 1.7;

margin-bottom: 2rem;
}

.hero-actions {
display: flex;
gap: 1rem;
flex-wrap: wrap;
}

.button {
display: inline-flex;

align-items: center;
justify-content: center;

min-height: 52px;

padding: 0 1.5rem;

border: 1px solid #111111;

font-size: 0.85rem;
font-weight: 700;

transition:
transform 0.2s ease,
background 0.2s ease;
}

.button:hover {
transform: translateY(-3px);
}

.button-primary {
background: #111111;
color: #ffffff;
}

.button-primary:hover {
background: #333333;
}

.button-secondary {
background: transparent;
}


/* =========================================
HERO VISUAL
========================================= */

.hero-visual {
display: flex;
justify-content: center;
}

.visual-card {
position: relative;

width: min(100%, 430px);
aspect-ratio: 0.8;

overflow: hidden;

background: #111111;
color: #ffffff;

padding: 2rem;

transform: rotate(3deg);

box-shadow: 25px 25px 0 var(--accent);

transition: transform 0.4s ease;
}

.visual-card:hover {
transform: rotate(0deg) translateY(-8px);
}

.visual-number {
font-family: "Space Grotesk", sans-serif;

font-size: 5rem;
font-weight: 700;

opacity: 0.15;
}

.visual-text {
position: absolute;
left: 2rem;
bottom: 2rem;

display: flex;
flex-direction: column;
}

.visual-text span {
font-size: 0.7rem;
text-transform: uppercase;
letter-spacing: 0.15em;
color: #aaaaaa;
}

.visual-text strong {
font-family: "Space Grotesk", sans-serif;

font-size: clamp(2.5rem, 5vw, 4rem);
line-height: 0.9;

letter-spacing: -0.06em;
}

.visual-circle {
position: absolute;

width: 180px;
height: 180px;

right: -60px;
top: 20%;

border: 30px solid var(--accent);

border-radius: 50%;

mix-blend-mode: screen;
}


/* =========================================
MARQUEE
========================================= */

.marquee {
overflow: hidden;

background: var(--accent);
color: #111111;

border-top: 1px solid #111111;
border-bottom: 1px solid #111111;
}

.marquee-track {
display: flex;
width: max-content;

animation: marquee 25s linear infinite;
}

.marquee-track span {
padding: 1rem 2rem;

font-family: "Space Grotesk", sans-serif;

font-size: 0.8rem;
font-weight: 700;

text-transform: uppercase;
letter-spacing: 0.1em;
}

.marquee-track span::after {
content: "✦";
margin-left: 2rem;
}

@keyframes marquee {

from {
transform: translateX(0);
}

to {
transform: translateX(-50%);
}

}


/* =========================================
ABOUT
========================================= */

.about-grid {
display: grid;

grid-template-columns: 1fr 1fr;

gap: 6rem;
}

.large-text {
font-family: "Space Grotesk", sans-serif;

font-size: clamp(2rem, 4vw, 3.5rem);

line-height: 1.05;

letter-spacing: -0.04em;
}

.about-copy {
max-width: 600px;
}

.about-copy p {
margin-bottom: 1.5rem;

color: #55514b;
}


/* =========================================
PROJECTS
========================================= */

.project-list {
display: flex;
flex-direction: column;

gap: 8rem;
}

.project-card {
display: grid;

grid-template-columns: 1fr 1fr;

gap: 5rem;

align-items: center;
}

.project-card-reverse {
direction: rtl;
}

.project-card-reverse > * {
direction: ltr;
}

.project-image {
min-height: 520px;

display: flex;
align-items: center;
justify-content: center;

overflow: hidden;

position: relative;
}

.project-image::before {
content: "";

position: absolute;

inset: 10%;

border: 1px solid rgba(255, 255, 255, 0.2);
}

.project-image-one {
background:
linear-gradient(
135deg,
#202020,
#414141
);
}

.project-image-two {
background:
linear-gradient(
135deg,
#b6a98b,
#575144
);
}

.project-image-three {
background:
linear-gradient(
135deg,
#353535,
#171717
);
}

.project-image-content {
font-family: "Space Grotesk", sans-serif;

font-size: clamp(3rem, 7vw, 7rem);

font-weight: 700;

line-height: 0.85;

letter-spacing: -0.07em;

text-align: center;

color: #ffffff;

position: relative;
z-index: 1;
}

.project-info {
max-width: 550px;
}

.project-number {
color: #999999;

font-family: "Space Grotesk", sans-serif;

font-size: 0.7rem;
font-weight: 600;

text-transform: uppercase;
letter-spacing: 0.1em;

margin-bottom: 1rem;
}

.project-info h3 {
font-family: "Space Grotesk", sans-serif;

font-size: clamp(2rem, 4vw, 3.5rem);

line-height: 0.95;

letter-spacing: -0.05em;

margin-bottom: 1.5rem;
}

.project-info > p:not(.project-number) {
color: #b1b1b1;

margin-bottom: 1.5rem;
}

.tag-list,
.modal-tags {
display: flex;
gap: 0.5rem;
flex-wrap: wrap;

margin-bottom: 1.5rem;
}

.tag-list span,
.modal-tags span {
padding: 0.4rem 0.7rem;

border: 1px solid rgba(255, 255, 255, 0.25);

border-radius: 100px;

font-size: 0.7rem;
}

.text-button {
border: 0;
background: none;

color: var(--accent);

cursor: pointer;

font-size: 0.8rem;
font-weight: 700;

padding: 0;

transition: transform 0.2s ease;
}

.text-button:hover {
transform: translateX(5px);
}


/* =========================================
EDUCATION
========================================= */

.timeline {
border-top: 1px solid var(--border);
}

.timeline-item {
display: grid;

grid-template-columns: 220px 1fr;

gap: 3rem;

padding: 3rem 0;

border-bottom: 1px solid var(--border);
}

.timeline-date {
font-family: "Space Grotesk", sans-serif;

font-size: 0.8rem;
font-weight: 600;
}

.timeline-type {
color: #77736c;

font-size: 0.75rem;
text-transform: uppercase;

letter-spacing: 0.12em;
}

.timeline-content h3 {
font-family: "Space Grotesk", sans-serif;

font-size: clamp(1.8rem, 4vw, 3rem);

line-height: 1;

letter-spacing: -0.04em;

margin: 0.6rem 0;
}

.timeline-content p {
color: #77736c;
}


/* =========================================
SKILLS
========================================= */

.skills-grid {
display: grid;

grid-template-columns: repeat(4, 1fr);

border-top: 1px solid rgba(17, 17, 17, 0.2);
border-left: 1px solid rgba(17, 17, 17, 0.2);
}

.skill-card {
min-height: 430px;

padding: 2rem;

border-right: 1px solid rgba(17, 17, 17, 0.2);
border-bottom: 1px solid rgba(17, 17, 17, 0.2);

display: flex;
flex-direction: column;
}

.skill-number {
font-family: "Space Grotesk", sans-serif;

font-size: 0.75rem;
font-weight: 700;

margin-bottom: 5rem;
}

.skill-card h3 {
font-family: "Space Grotesk", sans-serif;

font-size: 2rem;

letter-spacing: -0.05em;

margin-bottom: 1.5rem;
}

.skill-card li {
padding: 0.35rem 0;

font-size: 0.85rem;

border-bottom: 1px solid rgba(17, 17, 17, 0.1);
}


/* =========================================
ACHIEVEMENTS
========================================= */

.achievement-list {
border-top: 1px solid var(--border);
}

.achievement {
display: grid;

grid-template-columns: 150px 1fr;

gap: 2rem;

padding: 2.5rem 0;

border-bottom: 1px solid var(--border);
}

.achievement-year {
font-family: "Space Grotesk", sans-serif;

font-size: 0.8rem;
font-weight: 700;
}

.achievement h3 {
font-family: "Space Grotesk", sans-serif;

font-size: clamp(1.5rem, 3vw, 2.3rem);

letter-spacing: -0.04em;

margin-bottom: 0.5rem;
}

.achievement p {
color: #77736c;

max-width: 700px;
}


/* =========================================
INTERESTS
========================================= */

.interests {
background: #111111;
color: #ffffff;
}

.interests-inner {
text-align: center;

max-width: 1000px;

margin-inline: auto;
}

.interests h2 {
font-family: "Space Grotesk", sans-serif;

font-size: clamp(3rem, 8vw, 7rem);

line-height: 0.9;

letter-spacing: -0.07em;

margin-bottom: 3rem;
}

.interests .eyebrow {
color: var(--accent);
}

.interest-tags {
display: flex;

justify-content: center;

flex-wrap: wrap;

gap: 0.75rem;
}

.interest-tags span {
border: 1px solid #444444;

border-radius: 100px;

padding: 0.6rem 1rem;

font-size: 0.75rem;

transition:
background 0.2s ease,
color 0.2s ease;
}

.interest-tags span:hover {
background: var(--accent);
color: #111111;
}


/* =========================================
CONTACT
========================================= */

.contact {
background: var(--accent);

min-height: 70vh;

display: flex;
align-items: center;
}

.contact-grid {
display: grid;

grid-template-columns: 1fr 0.7fr;

gap: 5rem;

align-items: end;
}

.contact h2 {
font-family: "Space Grotesk", sans-serif;

font-size: clamp(4rem, 9vw, 9rem);

line-height: 0.85;

letter-spacing: -0.08em;

max-width: 850px;
}

.contact-details {
max-width: 450px;
}

.contact-details > p {
margin-bottom: 2rem;

font-size: 1rem;
}

.contact-link {
display: block;

width: fit-content;

font-family: "Space Grotesk", sans-serif;

font-size: clamp(1.2rem, 3vw, 2rem);

letter-spacing: -0.04em;

border-bottom: 1px solid #111111;

margin-bottom: 0.75rem;

transition: opacity 0.2s ease;
}

.contact-link:hover {
opacity: 0.55;
}

.social-links {
display: flex;

flex-wrap: wrap;

gap: 1rem;

margin-top: 2.5rem;
}

.social-links a {
font-size: 0.8rem;

font-weight: 700;

border-bottom: 1px solid #111111;
}


/* =========================================
FOOTER
========================================= */

.footer {
background: #111111;
color: #ffffff;

padding: 1.5rem 0;
}

.footer-inner {
display: flex;

justify-content: space-between;
align-items: center;

gap: 1rem;
}

.footer p,
.footer a {
color: #999999;

font-size: 0.7rem;
}

.footer a {
color: #ffffff;
}


/* =========================================
MODAL
========================================= */

.modal {
position: fixed;

inset: 0;

z-index: 2000;

display: none;

align-items: center;
justify-content: center;

padding: 1.5rem;
}

.modal.active {
display: flex;
}

.modal-overlay {
position: absolute;

inset: 0;

background: rgba(0, 0, 0, 0.75);

backdrop-filter: blur(8px);
}

.modal-content {
position: relative;

z-index: 1;

width: min(700px, 100%);

max-height: 90vh;

overflow-y: auto;

padding: clamp(2rem, 6vw, 4rem);

background: var(--background);

color: #111111;
}

.modal-content h2 {
font-family: "Space Grotesk", sans-serif;

font-size: clamp(2.5rem, 6vw, 5rem);

line-height: 0.9;

letter-spacing: -0.06em;

margin-bottom: 1.5rem;
}

.modal-content > p:not(.eyebrow) {
color: #5e5a54;

margin-bottom: 2rem;
}

.modal-tags span {
color: #111111;

border-color: var(--border);
}

.modal-close {
position: absolute;

top: 1rem;
right: 1rem;

width: 44px;
height: 44px;

border: 1px solid var(--border);

background: transparent;

font-size: 1.5rem;

cursor: pointer;
}


/* =========================================
SCROLL ANIMATION
========================================= */

.section-heading,
.project-card,
.timeline-item,
.skill-card,
.achievement {
opacity: 0;
transform: translateY(30px);

transition:
opacity 0.7s ease,
transform 0.7s ease;
}

.reveal {
opacity: 1;

transform: translateY(0);
}


/* =========================================
RESPONSIVE — TABLET
========================================= */

@media (max-width: 1000px) {

.hero-grid {
grid-template-columns: 1fr;
gap: 4rem;
}

.hero-visual {
justify-content: flex-start;
}

.visual-card {
width: min(100%, 360px);
}

.project-card {
grid-template-columns: 1fr;
gap: 3rem;
}

.project-card-reverse {
direction: ltr;
}

.project-image {
min-height: 450px;
}

.skills-grid {
grid-template-columns: repeat(2, 1fr);
}

.contact-grid {
grid-template-columns: 1fr;
}

}


/* =========================================
RESPONSIVE — MOBILE
========================================= */

@media (max-width: 700px) {

:root {
--space-xl: 5rem;
}

.container {
width: min(
calc(100% - 2rem),
var(--container)
);
}


/* Navigation */

.navbar {
min-height: 68px;
}

.menu-toggle {
display: block;
}

.nav-menu {
position: absolute;

top: 68px;
left: 0;
right: 0;

display: none;

flex-direction: column;

align-items: flex-start;

padding: 1.5rem;

background: var(--background);

border-bottom: 1px solid var(--border);
}

.nav-menu.active {
display: flex;
}

.nav-menu a {
font-size: 1rem;
}


/* Hero */

.hero {
padding-top: 120px;
}

.hero h1 {
font-size: clamp(
3.2rem,
17vw,
6rem
);
}

.hero-description {
font-size: 1rem;
}

.visual-card {
box-shadow: 15px 15px 0 var(--accent);
}


/* Sections */

.section-heading {
grid-template-columns: 1fr;

gap: 1rem;

margin-bottom: 3rem;
}

.section-heading h2 {
font-size: clamp(
2.5rem,
13vw,
4rem
);
}


/* About */

.about-grid {
grid-template-columns: 1fr;

gap: 2rem;
}


/* Projects */

.project-list {
gap: 5rem;
}

.project-image {
min-height: 350px;
}


/* Education */

.timeline-item {
grid-template-columns: 1fr;

gap: 1rem;

padding: 2rem 0;
}


/* Skills */

.skills-grid {
grid-template-columns: 1fr;
}

.skill-card {
min-height: auto;

padding: 1.5rem;
}

.skill-number {
margin-bottom: 2rem;
}


/* Achievements */

.achievement {
grid-template-columns: 1fr;

gap: 0.75rem;

padding: 2rem 0;
}


/* Contact */

.contact {
min-height: auto;
}

.contact h2 {
font-size: clamp(
3.5rem,
16vw,
6rem
);
}

.contact-grid {
gap: 3rem;
}


/* Footer */

.footer-inner {
flex-direction: column;

align-items: flex-start;
}

}


/* =========================================
ACCESSIBILITY
========================================= */

:focus-visible {
outline: 3px solid #6f8a00;
outline-offset: 4px;
}

@media (prefers-reduced-motion: reduce) {

html {
scroll-behavior: auto;
}

*,
*::before,
*::after {
animation-duration: 0.01ms !important;
animation-iteration-count: 1 !important;
transition-duration: 0.01ms !important;
}

}